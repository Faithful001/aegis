ENVIRONMENT=development
PORT=5000
LOG_LEVEL=info
LOG_FORMAT=json

# PostgreSQL
DATABASE_URL=postgresql://aegis_user:aegis_password@localhost:5432/aegis_db
POSTGRES_DB=aegis_db
POSTGRES_USER=aegis_user
POSTGRES_PASSWORD=aegis_password

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your_jwt_secret
JWT_ISSUER=aegis
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h

# Inference Worker (gRPC)
INFERENCE_WORKER_ADDR=localhost:50051

# Inference Worker (Python)
WORKER_ID=inference-worker-1
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_MAX_WORKERS=10

KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=aegis-consumer-group

RESEND_API_KEY=your_resend_api_key
RESEND_FROM_ADDR=

# OAuth 2.0
# Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback?provider=google

#GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback?provider=github